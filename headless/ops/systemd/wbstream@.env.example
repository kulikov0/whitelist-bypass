# Per-instance creator config - copy to /etc/whitelist-bypass/wbstream-<instance>.env
#
# One file per instance. Each instance needs its own WB Stream account and its
# own cookies: a second creator on the same account will fight the first one
# for the session.

WB_COOKIES=/etc/whitelist-bypass/cookies-wbstream-main.json
WB_LINK_FILE=/var/lib/whitelist-bypass/link-main.txt
WB_RESOURCES=default

# Extra flags, passed through as-is and split on whitespace.
#
# --room pins the creator to one room so the join link survives restarts.
# Without it every start mints a fresh UUID and you have to retype the link on
# the phone. Leave WB_FLAGS empty on the very first run, read the UUID out of
# WB_LINK_FILE once it comes up, then put it here and restart.
WB_FLAGS=--room wbstream://<room-uuid>
